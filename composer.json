{
  "name": "somethingwithproof/plugin-cache",
  "description": "Cacti 1.2 standalone Object Cache, Transients, Cache Tags, and Resumable Batch Queue plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Somethingwithproof\\Cache\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Somethingwithproof\\Cache\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml",
    "test:integration": "phpunit -c phpunit-integration.xml",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress"
  },
  "config": {
    "sort-packages": true
  }
}

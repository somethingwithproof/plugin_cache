msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "مدة القفل أحادي التنفيذ بالثواني للدالة CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "معامل بيتا لـ XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "مضاعف الانتهاء المبكر الاحتمالي (الافتراضي 1.0؛ اضبطه على 0 لتعطيل إعادة الحساب المبكرة)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "سعة S3-FIFO لمشغل الذاكرة"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "الحد الأقصى للإدخالات المحتفظ بها في MemoryDriver قبل تشغيل إخلاء S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "نقل Redis (RESP2 بلغة PHP خالصة)"


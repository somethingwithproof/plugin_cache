msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "مدة الحجز بالثواني قبل أن يصبح عنصر قائمة الانتظار غير المؤكد قابلا للاستعادة."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "الحد الأقصى الافتراضي للمحاولات"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "الحد الأقصى لمحاولات التسليم قبل نقل العنصر إلى حالة الرسائل الميتة."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "الاحتفاظ بجداول الإضافة عند إلغاء التثبيت"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "الاحتفاظ بجداول plugin_cache_entries وplugin_cache_tags وplugin_cache_queue عند إلغاء التثبيت."


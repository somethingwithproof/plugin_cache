#: cache_operator.php
#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "تم إفراغ مجموعة التخزين المؤقت \"%s\" (%d إدخال)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "حدد مربع التأكيد قبل إفراغ جميع إدخالات التخزين المؤقت."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "تم إفراغ جميع إدخالات التخزين المؤقت (%d إدخال)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "يرجى تقديم وسم تخزين مؤقت واحد على الأقل لإبطاله."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "تم إبطال %d وسم تخزين مؤقت."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "تم تنظيف %d إدخال منتهي الصلاحية واستعادة %d مهلة حجز منتهية في قائمة الانتظار."

#: cache_operator.php
#, php-format

msgstr "لم يتم العثور على عنصر قائمة الرسائل الميتة #%d."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "حدد مربع التأكيد قبل تصفية عناصر قائمة الرسائل الميتة."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."
msgstr "تمت تصفية %d عنصر من قائمة الرسائل الميتة."

#: cache_operator.php
msgid "Unsupported operator action."
msgstr "إجراء المشغل غير مدعوم."


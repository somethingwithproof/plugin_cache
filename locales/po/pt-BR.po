msgstr "Duração da concessão em segundos antes que um item não confirmado da fila possa ser recuperado."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Máximo padrão de tentativas"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Máximo de tentativas de entrega antes de mover um item para o status de mensagem morta."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Manter tabelas do plugin ao desinstalar"


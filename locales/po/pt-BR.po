msgstr "Tempo limite de conexão e leitura/gravação do socket em segundos."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Referência de segredo do Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Referência de segredo tipada (env:VAR ou vault:plugin:slot); senhas em texto simples nunca são armazenadas."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Fila em lote retomável"


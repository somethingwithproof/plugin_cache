msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Διάρκεια κλειδώματος μοναδικής εκτέλεσης σε δευτερόλεπτα για τη μέθοδο CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Συντελεστής βήτα XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Πιθανοτικός πολλαπλασιαστής πρόωρης λήξης (προεπιλογή 1.0· ορίστε 0 για απενεργοποίηση πρόωρου επανυπολογισμού)."

#: lib/Settings.php lib/Ui/PagesRenderer.php

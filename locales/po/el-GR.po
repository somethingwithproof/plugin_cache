msgstr "Χρονικό όριο σύνδεσης και ανάγνωσης/εγγραφής υποδοχής σε δευτερόλεπτα."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Αναφορά μυστικού Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."

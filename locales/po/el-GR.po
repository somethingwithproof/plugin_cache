msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Διατήρηση των πινάκων plugin_cache_entries, plugin_cache_tags και plugin_cache_queue κατά την απεγκατάσταση."


msgid "Cache Driver"
msgstr "Πρόγραμμα οδήγησης κρυφής μνήμης"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Πρόγραμμα οδήγησης υποστήριξης που χρησιμοποιείται για κρυφή μνήμη αντικειμένων και προσωρινή αποθήκευση."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (κοινόχρηστη στη μνήμη)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (υποδοχή RESP2 αμιγούς PHP)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Μνήμη διεργασίας (με όριο S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Προεπιλεγμένο TTL (δευτερόλεπτα)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Προεπιλεγμένος χρόνος λήξης καταχώρισης κρυφής μνήμης σε δευτερόλεπτα όταν δεν παρέχεται TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Μέγιστο μέγεθος φορτίου (byte)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Ανώτατο όριο σε byte για κωδικοποιημένα σε JSON φορτία κρυφής μνήμης και ουράς (1024 έως 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Πρόθεμα κλειδιών"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Πρόθεμα χώρου ονομάτων κλειδιών που εφαρμόζεται σε κοινόχρηστα συστήματα υποστήριξης (APCu και Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL κλειδώματος αποτροπής υπερφόρτωσης (δευτερόλεπτα)"


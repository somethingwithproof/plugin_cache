msgstr "ソケット接続および読み書きのタイムアウト時間 (秒) です。"

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Redis シークレット参照"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "型付きシークレット参照 (env:VAR または vault:plugin:slot) です。生のパスワードは保存されません。"


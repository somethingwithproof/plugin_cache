#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Очищено групу кешу \"%s\" (записів: %d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Установіть прапорець підтвердження перед очищенням усіх записів кешу."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Очищено всі записи кешу (записів: %d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Вкажіть принаймні один тег кешу для інвалідації."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "Інвалідовано тегів кешу: %d."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "Видалено застарілих записів: %d; повернуто прострочених оренд черги: %d."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Елемент черги недоставлених #%d повторно додано в чергу."

#: cache_operator.php
#, php-format
msgid "Dead-letter item #%d was not found."
msgstr "Елемент черги недоставлених #%d не знайдено."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "Установіть прапорець підтвердження перед очищенням елементів черги недоставлених."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."
msgstr "Видалено елементів із черги недоставлених: %d."

#: cache_operator.php
msgid "Unsupported operator action."
msgstr "Непідтримувана дія оператора."


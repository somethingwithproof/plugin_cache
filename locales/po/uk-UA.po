#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Драйвер кешу"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Серверний драйвер, що використовується для кешу об'єктів і тимчасового сховища."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (спільна оперативна пам'ять)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (сокет RESP2 на чистому PHP)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Пам'ять процесу (обмежена S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL за замовчуванням (секунди)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Термін дії запису кешу в секундах за замовчуванням, якщо TTL не вказано."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Максимальний розмір корисного навантаження (байти)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Верхня межа в байтах для корисного навантаження кешу та черги у форматі JSON (від 1024 до 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Префікс ключів"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Префікс простору імен ключів, що застосовується у спільних бекендах (APCu та Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL блокування лавиноподібних запитів (секунди)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Тривалість одноразового блокування в секундах для CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Бета-коефіцієнт XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Множник імовірнісного завчасного завершення терміну дії (за замовчуванням 1.0; вкажіть 0, щоб вимкнути завчасний перерахунок)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Ємність S3-FIFO драйвера пам'яті"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Максимальна кількість записів, що зберігаються в MemoryDriver до запуску витіснення S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Транспорт Redis (RESP2 на чистому PHP)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Хост Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Ім'я хоста або IP-адреса сервера Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Порт Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Порт TCP або TLS для сервера Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Увімкнути Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Підключатися до Redis за допомогою tls:// із перевіркою сертифіката віддаленого вузла."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Індекс бази даних Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Логічний номер бази даних Redis (від 0 до 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Таймаут Redis (секунди)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Таймаут підключення та читання/запису сокета в секундах."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Посилання на секрет Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Типізоване посилання на секрет (env:VAR або vault:plugin:slot); відкриті паролі ніколи не зберігаються."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Відновлювана пакетна черга"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Оренда черги за замовчуванням (секунди)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Тривалість оренди в секундах, після якої непідтверджений елемент черги може бути повернутий у роботу."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Максимум спроб за замовчуванням"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Максимальна кількість спроб доставки перед переміщенням елемента до статусу недоставленого."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Зберігати таблиці плагіна під час видалення"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Зберігати таблиці plugin_cache_entries, plugin_cache_tags та plugin_cache_queue під час видалення."


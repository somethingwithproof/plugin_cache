msgid "Active cache driver connectivity probe succeeded."
msgstr "Перевірка підключення активного драйвера кешу пройшла успішно."

#: cache_admin.php
msgid "Active cache driver connectivity probe failed."
msgstr "Перевірка підключення активного драйвера кешу завершилася помилкою."

#: cache_admin.php
msgid "Saved plugin_cache configuration."
msgstr "Конфігурацію plugin_cache збережено."


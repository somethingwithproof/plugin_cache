#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Àwọn Ìgbìyànjú Tí Ó Pọ̀ Jù Àtìpìlẹ̀"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Iye ìgbìyànjú ìfìránṣẹ́ tí ó pọ̀ jù lọ ṣáájú gbígbé ohun kan sí ipò ìlà iṣẹ́ tí ó kùnà."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Pa Àwọn Tábìlì Àfikún Mọ́ Nígbà Ìyọkúrò"


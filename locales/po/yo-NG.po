msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Pa àwọn tábìlì plugin_cache_entries, plugin_cache_tags, àti plugin_cache_queue mọ́ nígbà tí a bá yọ àfikún kúrò."


msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Трајање закључавања за једноструко извршавање у секундама за CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "XFetch бета фактор"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Множилац вероватноће раног истицања (подразумевано 1.0; поставите 0 да онемогућите рано поновно израчунавање)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "S3-FIFO капацитет меморијског драјвера"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Максималан број ставки задржаних у MemoryDriver пре покретања S3-FIFO избацивања."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis транспорт (чисти PHP RESP2)"


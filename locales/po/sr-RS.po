msgid "Redis Host"
msgstr "Redis хост"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Име хоста или IP адреса Redis сервера."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Redis порт"


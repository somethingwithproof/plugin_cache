msgid "Backend driver used for object cache and transient storage."
msgstr "Позадински драјвер за објектни кеш и привремено складиште."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (дељена меморија)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (чисти PHP RESP2 сокет)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Меморија процеса (ограничена са S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Подразумевани TTL (секунде)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Подразумевани рок истицања ставке кеша у секундама када TTL није наведен."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Максимална величина садржаја (бајтови)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Горња граница у бајтовима за JSON кодирани садржај кеша и реда (1024 до 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Префикс кључа"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Префикс именског простора кључева који се примењује у дељеним позадинским системима (APCu и Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL закључавања против навале захтева (секунде)"


msgid "TCP or TLS port for the Redis server."
msgstr "TCP или TLS порт за Redis сервер."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Омогући Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Повежи се са Redis сервером користећи tls:// уз проверу сертификата друге стране."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Индекс Redis базе података"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Логички број Redis базе података (од 0 до 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Временско ограничење за Redis (секунде)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Временско ограничење повезивања и читања/писања сокета у секундама."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Референца на Redis тајну"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Типизирана референца на тајну (env:VAR или vault:plugin:slot); сирове лозинке се никада не чувају."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Наставиви групни ред"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Подразумевани закуп реда (секунде)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Трајање закупа у секундама пре него што непотврђена ставка у реду постане доступна за преузимање."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Подразумевани максималан број покушаја"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Максималан број покушаја испоруке пре премештања ставке у статус неуспелих."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Задржи табеле додатка при деинсталацији"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Сачувај табеле plugin_cache_entries, plugin_cache_tags и plugin_cache_queue при деинсталацији."


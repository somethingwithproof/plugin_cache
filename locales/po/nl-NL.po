msgid "Redis Timeout (seconds)"
msgstr "Redis-time-out (seconden)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Time-out in seconden voor socketverbinding en lezen/schrijven."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Redis-geheimverwijzing"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Getypte geheimverwijzing (env:VAR of vault:plugin:slot); wachtwoorden in platte tekst worden nooit opgeslagen."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Hervatbare batchwachtrij"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Standaard wachtrij-lease (seconden)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Leaseduur in seconden voordat een niet-bevestigd wachtrij-item opnieuw kan worden opgeëist."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Standaard maximaal aantal pogingen"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Maximaal aantal afleverpogingen voordat een item naar de uitvalstatus wordt verplaatst."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Plugintabellen behouden bij verwijderen"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Behoud de tabellen plugin_cache_entries, plugin_cache_tags en plugin_cache_queue bij het verwijderen."


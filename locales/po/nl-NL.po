#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Standaard TTL (seconden)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Standaard vervaltijd van cachevermeldingen in seconden wanneer geen TTL is opgegeven."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Maximale gegevensgrootte (bytes)"


msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Duur in seconden van de enkele-uitvoeringvergrendeling voor CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "XFetch bètafactor"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Probabilistische vermenigvuldigingsfactor voor vervroegd vervallen (standaard 1.0; stel in op 0 om vervroegd herberekenen uit te schakelen)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "S3-FIFO-capaciteit van geheugendriver"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Maximaal aantal vermeldingen dat in MemoryDriver wordt bewaard voordat S3-FIFO-verwijdering wordt uitgevoerd."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis-transport (puur PHP, RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Redis-host"


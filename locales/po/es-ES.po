msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Duración en segundos del bloqueo de ejecución única para CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Factor beta de XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Multiplicador probabilístico de caducidad anticipada (predeterminado: 1.0; establezca 0 para deshabilitar el recálculo anticipado)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Capacidad S3-FIFO del controlador de memoria"


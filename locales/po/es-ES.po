msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Transporte Redis (RESP2 en PHP puro)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Host de Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Nombre de host o dirección IP del servidor Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Puerto de Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Puerto TCP o TLS del servidor Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Habilitar Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Conectar a Redis mediante tls:// con verificación del certificado del par."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Índice de base de datos Redis"


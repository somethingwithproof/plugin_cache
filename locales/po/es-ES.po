#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Controlador de backend utilizado para la caché de objetos y el almacenamiento temporal."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (memoria compartida)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (socket RESP2 en PHP puro)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Memoria de proceso (acotada por S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL predeterminado (segundos)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Caducidad predeterminada de la entrada de caché en segundos cuando no se indica ningún TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Tamaño máximo de carga útil (bytes)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Límite superior en bytes para las cargas útiles de caché y cola codificadas en JSON (de 1024 a 16777216)."


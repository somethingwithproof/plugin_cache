msgid "Redis Timeout (seconds)"
msgstr "Tiempo de espera de Redis (segundos)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Tiempo de espera en segundos para la conexión y lectura/escritura del socket."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Referencia de secreto de Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Referencia tipada de secreto (env:VAR o vault:plugin:slot); nunca se almacenan contraseñas en texto plano."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Cola por lotes reanudable"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Concesión predeterminada de cola (segundos)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Duración de la concesión en segundos antes de que un elemento de cola no confirmado pueda reclamarse."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Máximo de intentos predeterminado"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Número máximo de intentos de entrega antes de mover un elemento al estado de mensajes fallidos."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Conservar tablas del complemento al desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Conservar las tablas plugin_cache_entries, plugin_cache_tags y plugin_cache_queue al desinstalar."


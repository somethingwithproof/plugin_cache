#: cache_operator.php
#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Wyczyszczono grupę pamięci podręcznej „%s” (wpisy: %d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Zaznacz pole potwierdzenia przed wyczyszczeniem wszystkich wpisów pamięci podręcznej."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Wyczyszczono wszystkie wpisy pamięci podręcznej (wpisy: %d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Podaj co najmniej jeden tag pamięci podręcznej do unieważnienia."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "Unieważniono tagi pamięci podręcznej: %d."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "Usunięto wygasłe wpisy (%d) i odzyskano wygasłe dzierżawy kolejki (%d)."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Ponownie zakolejkowano odrzucone zadanie #%d."


msgstr "Sterownik pamięci podręcznej"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Sterownik zaplecza używany do pamięci podręcznej obiektów i danych tymczasowych."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (współdzielona w pamięci RAM)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (gniazdo RESP2 w czystym PHP)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Pamięć procesu (z ograniczeniem S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Domyślny TTL (sekundy)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Domyślny czas wygasania wpisu w pamięci podręcznej w sekundach, gdy nie podano TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Maksymalny rozmiar ładunku (bajty)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Górny limit w bajtach dla zakodowanych w JSON ładunków pamięci podręcznej i kolejki (od 1024 do 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Prefiks klucza"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Prefiks przestrzeni nazw kluczy stosowany we współdzielonych zapleczach (APCu i Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL blokady przed efektem lawinowym (sekundy)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Czas trwania blokady pojedynczego wykonania w sekundach dla CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Współczynnik beta XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Probabilistyczny mnożnik wcześniejszego wygasania (domyślnie 1.0; ustaw 0, aby wyłączyć wcześniejsze przeliczanie)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Pojemność S3-FIFO sterownika pamięci"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Maksymalna liczba wpisów przechowywanych w MemoryDriver przed uruchomieniem usuwania S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Transport Redis (RESP2 w czystym PHP)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Host Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Nazwa hosta lub adres IP serwera Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Port Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Port TCP lub TLS serwera Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Włącz Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Łącz się z serwerem Redis przez tls:// z weryfikacją certyfikatu serwera."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Indeks bazy danych Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Logiczny numer bazy danych Redis (od 0 do 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Limit czasu Redis (sekundy)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Limit czasu nawiązywania połączenia oraz odczytu/zapisu gniazda w sekundach."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Odwołanie do sekretu Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Typowane odwołanie do sekretu (env:VAR lub vault:plugin:slot); jawne hasła nigdy nie są przechowywane."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Wznawialna kolejka wsadowa"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Domyślna dzierżawa kolejki (sekundy)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Czas trwania dzierżawy w sekundach, po którym niepotwierdzony element kolejki można odzyskać."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Domyślna maksymalna liczba prób"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Maksymalna liczba prób dostarczenia przed przeniesieniem elementu do kolejki odrzuconych zadań."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zachowaj tabele wtyczki przy odinstalowaniu"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Zachowaj tabele plugin_cache_entries, plugin_cache_tags oraz plugin_cache_queue podczas odinstalowywania."


#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Cache-Treiber"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Backend-Treiber für den Objekt-Cache und temporäre Zwischenspeicherung."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (gemeinsamer Arbeitsspeicher)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (reiner PHP-RESP2-Socket)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Prozessspeicher (durch S3-FIFO begrenzt)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Standard-TTL (Sekunden)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Standardmäßige Ablaufzeit von Cache-Einträgen in Sekunden, wenn keine TTL angegeben wird."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Maximale Nutzdatengröße (Bytes)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Obergrenze in Bytes für JSON-codierte Cache- und Warteschlangen-Nutzdaten (1024 bis 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Schlüsselpräfix"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Namensraumpräfix für Schlüssel in gemeinsam genutzten Backends (APCu und Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "Sperr-TTL gegen Cache-Stampede (Sekunden)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Einzelausführungs-Sperrdauer in Sekunden für CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "XFetch-Beta-Faktor"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Multiplikator für probabilistischen vorzeitigen Ablauf (Standard: 1.0; 0 deaktiviert die vorzeitige Neuberechnung)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "S3-FIFO-Kapazität des Speichertreibers"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Maximale Anzahl der im MemoryDriver gespeicherten Einträge, bevor die S3-FIFO-Verdrängung ausgeführt wird."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis-Transport (reines PHP, RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Redis-Host"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Hostname oder IP-Adresse des Redis-Servers."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Redis-Port"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "TCP- oder TLS-Port des Redis-Servers."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Redis TLS aktivieren"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Verbindung zu Redis über tls:// mit Überprüfung des Gegenstellenzertifikats herstellen."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Redis-Datenbankindex"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Logische Redis-Datenbanknummer (0 bis 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Redis-Zeitlimit (Sekunden)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Socket-Zeitlimit für Verbindungsaufbau sowie Lese- und Schreibvorgänge in Sekunden."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Redis-Geheimnisreferenz"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Typisierte Geheimnisreferenz (env:VAR oder vault:plugin:slot); Klartextpasswörter werden niemals gespeichert."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Fortsetzbare Stapelwarteschlange"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Standard-Reservierungsdauer der Warteschlange (Sekunden)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Reservierungsdauer in Sekunden, bevor ein unbestätigter Warteschlangeneintrag wieder beansprucht werden kann."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Standardmäßige maximale Versuche"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Maximale Zustellversuche, bevor ein Eintrag als unzustellbar markiert wird."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Plugin-Tabellen bei Deinstallation behalten"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Die Tabellen plugin_cache_entries, plugin_cache_tags und plugin_cache_queue bei der Deinstallation beibehalten."


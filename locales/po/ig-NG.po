#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Draịva Nchekwa Nwa Oge"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Draịva azụ sistemụ eji arụ ọrụ maka nchekwa ihe nwa oge na nchekwa dị mkpirikpi."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (nchekwa ebe nchekwa ekekọrịtara)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (sọket RESP2 nke PHP naanị)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Ebe Nchekwa Usoro (nwere oke S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL Ndabara (sekọnd)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Oge ngwụcha ndabara nke ndebanye nchekwa nwa oge na sekọnd mgbe enyeghị TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Oke Ibu Data Kasị Elu (bayịtị)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Oke kasị elu na bayịtị maka ibu data nchekwa nwa oge na ahịrị ọrụ echekwara na JSON (1024 ruo 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Okwu Mmalite Igodo"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Okwu mmalite aha mpaghara igodo etinyere n'ebe nchekwa azụ ekekọrịtara (APCu na Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL Mkpọchi Mgbochi Mkpọkọta (sekọnd)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Ogologo oge mkpọchi otu njem na sekọnd maka CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Ọnụọgụ Beta XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Ihe mmụba ohere mgwụcha tupu oge (ndabara 1.0; tinye 0 iji kwụsị mgbakọ ọhụrụ tupu oge)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Ikike S3-FIFO nke Draịva Ebe Nchekwa"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Ọnụọgụ ndebanye kasị elu edobere na MemoryDriver tupu mwepụ S3-FIFO amalite."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Nbufe Redis (RESP2 nke PHP Naanị)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Sava Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Aha sava ma ọ bụ adreesị IP maka sava Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Ọdụ Njikọ Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Ọdụ njikọ TCP ma ọ bụ TLS maka sava Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Kwado Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Jikọọ na Redis site na iji tls:// yana nnyocha asambodo ndị ọgbọ."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Nọmba Nchekwa Data Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Nọmba nchekwa data ezi uche nke Redis (0 ruo 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Oge Njedebe Redis (sekọnd)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Oge njedebe njikọ sọket na ọgụgụ/odide na sekọnd."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Ntụaka Nzuzo Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Ntụaka nzuzo ahaziri ụdị ya (env:VAR ma ọ bụ vault:plugin:slot); anaghị echekwa okwuntughe nkịtị."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Ahịrị Ọrụ Nchịkọta Enwere Ike Ịmaliteghachi"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Oge Mgbazinye Ahịrị Ọrụ Ndabara (sekọnd)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Ogologo oge mgbazinye na sekọnd tupu enwee ike ịnwetaghachi ihe ahịrị ọrụ a na-ekwubeghị nnabata ya."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Ọnụọgụ Nnwale Kasị Elu nke Ndabara"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Ọnụọgụ nnwale nnyefe kasị elu tupu ebufee ihe ahụ n'ọnọdụ ozi dara ada."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Debe Tebụl Ngwa Mgbakwunye Mgbe A Na-ewepụ Ya"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Chekwaa tebụl plugin_cache_entries, plugin_cache_tags, na plugin_cache_queue mgbe a na-ewepụ ngwa mgbakwunye."


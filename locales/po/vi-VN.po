#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Trình điều khiển bộ nhớ đệm"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Trình điều khiển phụ trợ dùng cho bộ nhớ đệm đối tượng và lưu trữ tạm thời."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (bộ nhớ dùng chung)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (socket RESP2 thuần PHP)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Bộ nhớ tiến trình (giới hạn S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL mặc định (giây)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Thời gian hết hạn mặc định của mục bộ nhớ đệm tính bằng giây khi không cung cấp TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Kích thước tải trọng tối đa (byte)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Giới hạn trên tính bằng byte cho tải trọng bộ nhớ đệm và hàng đợi mã hóa JSON (1024 đến 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Tiền tố khóa"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Tiền tố không gian tên khóa áp dụng trong các hệ thống phụ trợ dùng chung (APCu và Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL khóa chống dồn tải (giây)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Thời lượng khóa đơn luồng tính bằng giây cho CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Hệ số beta XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Hệ số nhân hết hạn sớm theo xác suất (mặc định 1.0; đặt 0 để tắt tính toán lại sớm)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Dung lượng S3-FIFO của trình điều khiển bộ nhớ"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Số mục tối đa được giữ lại trong MemoryDriver trước khi cơ chế loại bỏ S3-FIFO chạy."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Giao vận Redis (RESP2 thuần PHP)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Máy chủ Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Tên máy chủ hoặc địa chỉ IP của máy chủ Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Cổng Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Cổng TCP hoặc TLS của máy chủ Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Bật Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Kết nối đến Redis bằng tls:// kèm xác minh chứng chỉ ngang hàng."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Chỉ mục cơ sở dữ liệu Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Số cơ sở dữ liệu Redis logic (từ 0 đến 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Thời gian chờ Redis (giây)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Thời gian chờ kết nối và đọc/ghi socket tính bằng giây."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Tham chiếu bí mật Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Tham chiếu bí mật có định kiểu (env:VAR hoặc vault:plugin:slot); mật khẩu thô không bao giờ được lưu trữ."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Hàng đợi lô có thể tiếp tục"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Thời hạn giữ hàng đợi mặc định (giây)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Thời lượng giữ tính bằng giây trước khi một mục hàng đợi chưa được xác nhận có thể được thu hồi."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Số lần thử tối đa mặc định"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Số lần thử chuyển phát tối đa trước khi chuyển mục sang trạng thái thư chết."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Giữ lại bảng của plugin khi gỡ cài đặt"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Giữ nguyên các bảng plugin_cache_entries, plugin_cache_tags và plugin_cache_queue khi gỡ cài đặt."


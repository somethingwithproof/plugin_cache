#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Wadaha Kaydka"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Wadaha dambe ee loo isticmaalo kaydka shayga iyo kaydinta ku-meel-gaarka ah."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (xusuusta la wadaago)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (godka isku-xirka RESP2 ee PHP saafi ah)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Xusuusta Habka (S3-FIFO xaddidan)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL-ka Caadiga ah (ilbiriqsiyo)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Dhicitaanka caadiga ah ee xog-gelinta kaydka ilbiriqsiyo ahaan marka aan la bixin TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Cabbirka Ugu Badan ee Xamuulka (baytyo)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Xadka ugu sarreeya baytyo ahaan ee xamuulka kaydka iyo safka ee ku qoran JSON (1024 ilaa 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Horgalaha Furaha"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Horgalaha magac-goobta furaha ee lagu dabaqo nidaamyada dambe ee la wadaago (APCu iyo Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL-ka Qufulka Culeyska Degdegga ah (ilbiriqsiyo)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Muddada qufulka hal-mar fulinta ilbiriqsiyo ahaan ee loogu talagalay CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Qaybta Beta ee XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Isku-dhufashada dhicitaanka hore ee suurtogalka ah (caadiga ah 1.0; ka dhig 0 si aad u damiso dib-u-xisaabinta hore)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Awoodda S3-FIFO ee Wadaha Xusuusta"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Tirada ugu badan ee xog-gelinnada lagu hayo MemoryDriver ka hor inta aan la bilaabin ka-saaridda S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Gaadiidka Xogta Redis (PHP saafi ah RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Martigaliyaha Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Magaca martigaliyaha ama cinwaanka IP ee adeegaha Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Dekadda Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Dekadda TCP ama TLS ee adeegaha Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Hawl-geli Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Ku xir Redis adigoo isticmaalaya tls:// oo leh xaqiijinta shahaadada dhinaca kale."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Tusaha Xog-kaydiyaha Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Lambarka macquulka ah ee xog-kaydiyaha Redis (0 ilaa 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Waqtiga Dhammaadka Redis (ilbiriqsiyo)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Waqtiga dhammaadka isku-xirka godka iyo akhrinta/qorista ilbiriqsiyo ahaan."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Tixraaca Sirta Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Tixraac sir oo nooc leh (env:VAR ama vault:plugin:slot); furayaasha sirta ah ee aan qarsoonayn marnaba lama kaydiyo."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Safka Kooxaysan ee Dib loo Sii Wadi Karo"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Muddada Haynta Caadiga ah ee Safka (ilbiriqsiyo)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Muddada haynta ilbiriqsiyo ahaan ka hor inta shay saf oo aan la qirin uusan noqon mid dib loo heli karo."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Isku-dayada Ugu Badan ee Caadiga ah"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Isku-dayada ugu badan ee gaarsiinta ka hor inta aan shayga loo wareejin xaaladda fashilmay."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Hay Jadwallada Kordhinta Marka la Tirtiro"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Xafid jadwallada plugin_cache_entries, plugin_cache_tags, iyo plugin_cache_queue marka la tirtiro."


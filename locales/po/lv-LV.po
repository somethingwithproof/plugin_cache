#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Kešatmiņas draiveris"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Aizmugursistēmas draiveris, ko izmanto objektu kešatmiņai un pagaidu glabāšanai."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (koplietojamā operatīvajā atmiņā)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (tīrs PHP RESP2 ligzdas savienojums)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Procesa atmiņa (S3-FIFO ierobežota)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Noklusējuma TTL (sekundēs)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Noklusējuma kešatmiņas ieraksta derīguma termiņš sekundēs, ja TTL nav norādīts."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Maksimālais datu apjoms (baitos)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Augšējā robeža baitos JSON kodētiem kešatmiņas un rindas datiem (no 1024 līdz 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Atslēgas prefikss"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Atslēgu nosaukumvietas prefikss, ko izmanto koplietojamās aizmugursistēmās (APCu un Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "Pārslodzes bloķēšanas TTL (sekundēs)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Vienlaicīgas izpildes bloķēšanas ilgums sekundēs metodei CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "XFetch beta koeficients"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Varbūtiskais agrīnās derīguma beigšanās reizinātājs (noklusējums 1.0; iestatiet 0, lai atspējotu agrīnu pārrēķinu)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Atmiņas draivera S3-FIFO ietilpība"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Maksimālais ierakstu skaits, kas tiek glabāts MemoryDriver pirms S3-FIFO izstumšanas."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis transports (tīrs PHP RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Redis resursdators"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Redis servera resursdatora nosaukums vai IP adrese."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Redis ports"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Redis servera TCP vai TLS ports."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Iespējot Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Izveidot savienojumu ar Redis, izmantojot tls:// ar partnera sertifikāta verifikāciju."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Redis datubāzes indekss"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Loģiskās Redis datubāzes numurs (no 0 līdz 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Redis noildze (sekundēs)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Ligzdas savienojuma un lasīšanas/rakstīšanas noildze sekundēs."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Redis noslēpuma atsauce"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Tipizēta noslēpuma atsauce (env:VAR vai vault:plugin:slot); nešifrētas paroles nekad netiek glabātas."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Atsākama pakešu rinda"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Noklusējuma rindas rezervācijas ilgums (sekundēs)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Rezervācijas ilgums sekundēs, pēc kura neapstiprinātu rindas vienumu var atkārtoti piešķirt."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Noklusējuma maks. mēģinājumu skaits"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Maksimālais piegādes mēģinājumu skaits, pirms vienums tiek pārvietots uz nepiegādāto ziņojumu statusu."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Saglabāt spraudņa tabulas atinstalēšanas laikā"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Atinstalējot saglabāt tabulas plugin_cache_entries, plugin_cache_tags un plugin_cache_queue."


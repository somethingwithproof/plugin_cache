#: cache_admin.php cache_operator.php
msgid "CSRF verification failed. Reload the page and retry."
msgstr "Ukuqinisekiswa kwe-CSRF kuhlulekile. Layisha kabusha ikhasi bese uzama futhi."

#: cache_admin.php
msgid "Active cache driver connectivity probe succeeded."
msgstr "Ukuhlolwa kokuxhumeka komshayeli wenqolobane yesikhashana osebenzayo kuphumelele."

#: cache_admin.php
msgid "Active cache driver connectivity probe failed."
msgstr "Ukuhlolwa kokuxhumeka komshayeli wenqolobane yesikhashana osebenzayo kuhlulekile."

#: cache_admin.php
msgid "Saved plugin_cache configuration."
msgstr "Ukumiswa kwe-plugin_cache kulondoloziwe."

#: cache_admin.php
msgid "Unable to save plugin_cache configuration."
msgstr "Ayikwazi ukulondoloza ukumiswa kwe-plugin_cache."

#: cache_admin.php
msgid "Unsupported administrator action."
msgstr "Isenzo somlawuli esingasekelwe."

#: cache_admin.php
msgid "Object Cache Configuration & Driver Health (Administrator)"
msgstr "Ukumiswa Kwenqolobane Yesikhashana Yezinto Nempilo Yomshayeli (Umlawuli)"

#: cache_operator.php
#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Iqembu lenqolobane yesikhashana elithi \"%s\" lisuliwe (okufakiwe okungu-%d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Maka ibhokisi lokuqinisekisa ngaphambi kokusula konke okufakiwe enqolobaneni yesikhashana."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Konke okufakiwe enqolobaneni yesikhashana kusuliwe (okufakiwe okungu-%d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Nikeza okungenani ithegi eyodwa yenqolobane yesikhashana ukuze kuqedwe ukusebenza kwayo."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "Kuqedwe ukusebenza kwamathegi enqolobane yesikhashana angu-%d."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "Kususiwe okufakiwe okuphelelwe yisikhathi okungu-%d futhi kwabuyiswa izikhathi zokuqasha zolayini eziphelelwe yisikhathi ezingu-%d."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Into yemilayezo ehlulekile #%d ibuyiselwe kulayini."

#: cache_operator.php
#, php-format
msgid "Dead-letter item #%d was not found."
msgstr "Into yemilayezo ehlulekile #%d ayitholakalanga."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "Maka ibhokisi lokuqinisekisa ngaphambi kokusula unomphela izinto zemilayezo ehlulekile."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."
msgstr "Kusuliwe unomphela izinto zolayini wemilayezo ehlulekile ezingu-%d."

#: cache_operator.php
msgid "Unsupported operator action."
msgstr "Isenzo somqhubi esingasekelwe."

#: cache_operator.php
msgid "Object Cache Operations & Dead-Letter Queue (Operator)"
msgstr "Imisebenzi Yenqolobane Yesikhashana Yezinto Nolayini Wemilayezo Ehlulekile (Umqhubi)"


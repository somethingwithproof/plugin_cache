#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Umshayeli Wenqolobane Yesikhashana"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Umshayeli wangemuva osetshenziselwa inqolobane yesikhashana yezinto nokugcinwa kwesikhashana."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (okwabiwe kumemori)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (isokhethi ye-RESP2 ye-PHP emsulwa)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Imemori Yenqubo (enomkhawulo we-S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "I-TTL Ezenzakalelayo (imizuzwana)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Isikhathi esizenzakalelayo sokuphelelwa yisikhathi sokufakiwe enqolobaneni yesikhashana ngemizuzwana lapho kungafakwanga i-TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Usayizi Ophezulu Womthwalo Wedatha (amabhayithi)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Umkhawulo ophezulu ngamabhayithi emithwalweni yedatha yenqolobane yesikhashana nolayini efakwe ikhodi ye-JSON (1024 kuya ku-16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Isiqalo Sokhiye"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Isiqalo sendawo yamagama sokhiye esisetshenziswa ezinhlelweni zangemuva ezabiwe (APCu ne-Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "I-TTL Yokukhiya Ukugijimelana (imizuzwana)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Ubude besikhathi sokukhiya okukodwa ngemizuzwana komsebenzi othi CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Isici se-Beta se-XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Isiphindaphindi sokuphelelwa yisikhathi kusenesikhathi esisekelwe kumathuba (okuzenzakalelayo ngu-1.0; setha u-0 ukukhubaza ukubala kabusha kusenesikhathi)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Umthamo we-S3-FIFO Womshayeli Wememori"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Inani eliphezulu lokufakiwe okugcinwa ku-MemoryDriver ngaphambi kokuthi ukukhishwa kwe-S3-FIFO kusebenze."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Ukuthuthwa kwe-Redis (RESP2 ye-PHP Emsulwa)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Umsingathi we-Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Igama lomsingathi noma ikheli le-IP leseva ye-Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Imbobo ye-Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Imbobo ye-TCP noma ye-TLS yeseva ye-Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Nika Amandla i-Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Xhuma ku-Redis usebenzisa okuthi tls:// nokuqinisekiswa kwesitifiketi somlingani."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Inkomba Yedathabheyisi ye-Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Inombolo yedathabheyisi ye-Redis enengqondo (0 kuya ku-15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Isikhathi Sokuphela kwe-Redis (imizuzwana)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Isikhathi sokuphela sokuxhuma isokhethi nokufunda/ukubhala ngemizuzwana."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Inkomba Yemfihlo ye-Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Inkomba yemfihlo enohlobo (env:VAR noma vault:plugin:slot); amaphasiwedi angenasivikelo awalokothi agcinwe."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Ulayini Weqoqo Oqhubekekayo"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Isikhathi Sokuqasha Solayini Esizenzakalelayo (imizuzwana)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Ubude besikhathi sokuqasha ngemizuzwana ngaphambi kokuthi into yolayini engavunywanga ikwazi ukubuyiswa."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Inani Eliphezulu Lemizamo Elizenzakalelayo"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Inani eliphezulu lemizamo yokuletha ngaphambi kokuyisa into esimweni semilayezo ehlulekile."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Gcina Amathebula Esengezo Lapho Ukhipha"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Gcina amathebula athi plugin_cache_entries, plugin_cache_tags, kanye nelithi plugin_cache_queue lapho ukhipha isengezo."


#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Кеш драйвер"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Сървърен драйвер, използван за обектен кеш и временно съхранение."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (споделена памет)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (чист PHP RESP2 сокет)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Памет на процеса (ограничена със S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL по подразбиране (секунди)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Срок на валидност по подразбиране в секунди за кеш запис, когато не е зададен TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Максимален размер на полезния товар (байтове)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Горна граница в байтове за JSON-кодирания полезен товар в кеша и опашката (от 1024 до 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Префикс на ключовете"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Префикс за пространството от имена на ключовете, прилаган при споделени хранилища (APCu и Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL на заключването срещу претоварване (секунди)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Продължителност в секунди на единичното заключване за CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Бета коефициент на XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Множител за вероятностно ранно изтичане (по подразбиране 1.0; задайте 0 за изключване на ранното преизчисляване)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Капацитет на S3-FIFO за драйвера в паметта"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Максимален брой записи, съхранявани в MemoryDriver преди стартиране на изместване по S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Транспорт на Redis (чист PHP RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Хост на Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Име на хост или IP адрес на сървъра Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Порт на Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "TCP или TLS порт за сървъра Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Активиране на Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Свързване към Redis чрез tls:// с проверка на сертификата на сървъра."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Индекс на базата данни в Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Логически номер на базата данни в Redis (от 0 до 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Време за изчакване на Redis (секунди)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Време за изчакване в секунди при свързване и четене/запис през сокета."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Референция към тайна за Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Типизирана референция към тайна (env:VAR или vault:plugin:slot); пароли в явен вид никога не се съхраняват."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Възобновяема пакетна опашка"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Резервация в опашката по подразбиране (секунди)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Продължителност на резервацията в секунди, след която непотвърден елемент в опашката може да бъде освободен отново."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Макс. опити по подразбиране"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Максимален брой опити за доставка преди преместване на елемента в състояние на недоставени."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Запазване на таблиците на плъгина при деинсталиране"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Запазва таблиците plugin_cache_entries, plugin_cache_tags и plugin_cache_queue при деинсталиране."


#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "منفذ Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "منفذ TCP أو TLS لخادم Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "تفعيل Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "الاتصال بخادم Redis باستخدام tls:// مع التحقق من شهادة النظير."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "فهرس قاعدة بيانات Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "رقم قاعدة بيانات Redis المنطقية (من 0 إلى 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "مهلة Redis (بالثواني)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "مهلة اتصال المقبس والقراءة/الكتابة بالثواني."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "مرجع سر Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "مرجع سر مُحدّد النوع (env:VAR أو vault:plugin:slot)؛ لا يتم تخزين كلمات المرور الخام أبدًا."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "قائمة انتظار الدُفعات القابلة للاستئناف"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "مدة الحجز الافتراضية لقائمة الانتظار (بالثواني)"


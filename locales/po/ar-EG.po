#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "الاحتفاظ بجداول plugin_cache_entries وplugin_cache_tags وplugin_cache_queue عند إلغاء التثبيت."


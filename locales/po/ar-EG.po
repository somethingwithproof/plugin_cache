#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "محرّك التخزين المؤقت"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "المحرّك الخلفي المستخدم لذاكرة التخزين المؤقت للكائنات والتخزين المؤقت العابر."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (ذاكرة مشتركة)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (مقبس RESP2 بلغة PHP خالصة)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "ذاكرة العملية (محدودة بخوارزمية S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "مدة الصلاحية الافتراضية TTL (بالثواني)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "مدة انتهاء الصلاحية الافتراضية لمدخل التخزين المؤقت بالثواني عند عدم تحديد TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "الحد الأقصى لحجم الحمولة (بالبايت)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "الحد الأعلى بالبايت لحمولات التخزين المؤقت وقائمة الانتظار المرمّزة بصيغة JSON (من 1024 إلى 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "بادئة المفاتيح"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "بادئة مساحة أسماء المفاتيح المطبّقة في الواجهات الخلفية المشتركة (APCu وRedis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "مدة صلاحية TTL لقفل منع التدافع (بالثواني)"


#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "الحد الأقصى الافتراضي للمحاولات"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "الحد الأقصى لمحاولات التسليم قبل نقل العنصر إلى حالة الرسائل المتعثرة."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"

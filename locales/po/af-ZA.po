#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Verstek TTL (sekondes)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Verstek vervaltyd van kasinskrywings in sekondes wanneer geen TTL verskaf word nie."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Maksimum dataladinggrootte (grepe)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Boonste perk in grepe op JSON-gekodeerde kas- en toudataladings (1024 tot 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Sleutelvoorvoegsel"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Sleutelnaamruimte-voorvoegsel wat in gedeelde agterkante (APCu en Redis) toegepas word."


#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (gedeel in geheue)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (suiwer-PHP RESP2-sok)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"

msgid "Stampede Lock TTL (seconds)"
msgstr "Stormloopslot-TTL (sekondes)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Enkelvlug-slotduur in sekondes vir CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "XFetch Beta-faktor"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Waarskynlikheidsvermenigvuldiger vir vroeë verval (verstek 1.0; stel op 0 om vroeë herberekening te deaktiveer)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "S3-FIFO-kapasiteit van geheuedrywer"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Maksimum inskrywings wat in MemoryDriver behou word voordat S3-FIFO-uitsetting loop."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis-vervoer (Suiwer-PHP RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Redis-gasheer"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Gasheernaam of IP-adres vir die Redis-bediener."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Redis-poort"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "TCP- of TLS-poort vir die Redis-bediener."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Aktiveer Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Koppel aan Redis met tls:// en eweknie-sertifikaatverifikasie."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Redis-databasisindeks"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Logiese Redis-databasisnommer (0 tot 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Redis-tydverstryking (sekondes)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Sok-verbindings- en lees-/skryftydverstryking in sekondes."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Redis-geheimverwysing"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Getipeerde geheimverwysing (env:VAR of vault:plugin:slot); rou wagwoorde word nooit gestoor nie."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Hervatbare bondeltou"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Verstek tou-huurtyd (sekondes)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Huurtydduur in sekondes voordat 'n onbevestigde tou-item herwinbaar word."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Verstek maksimum pogings"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Maksimum afleweringspogings voordat 'n item na doodloopstatus geskuif word."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Behou inpropmodule-tabelle by deïnstallasie"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Behou plugin_cache_entries, plugin_cache_tags en plugin_cache_queue tabelle by deïnstallasie."


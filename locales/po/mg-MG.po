#: cache_operator.php
#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Nodiovina ny vondrona tahiry vonjimaika \"%s\" (singa %d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Mariho ny boaty fanamafisana alohan'ny hanadiovana ny singa rehetra ao amin'ny tahiry vonjimaika."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Nodiovina ny singa rehetra ao amin'ny tahiry vonjimaika (singa %d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Manomeza marika tahiry vonjimaika iray farafahakeliny hofoanana."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "Nofoanana ny marika tahiry vonjimaika %d."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "Nesorina ny singa lany daty %d ary naverina nalaina ny fitanana filaharana lany daty %d."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Naverina napetraka ao amin'ny filaharana ny singa tsy lasa #%d."

#: cache_operator.php
#, php-format
msgid "Dead-letter item #%d was not found."
msgstr "Tsy hita ny singa tsy lasa #%d."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "Mariho ny boaty fanamafisana alohan'ny hamafana tanteraka ny singa tsy lasa."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."
msgstr "Voaesotra tanteraka ny singa %d ao amin'ny filaharan'ny tsy lasa."


#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Mpamily Tahiry Vonjimaika"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Mpamily rafitra ambadika ampiasaina amin'ny tahiry vonjimaika singa sy ny fitahirizana mandalo."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (fitadidiana iombonana)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (sokety RESP2 amin'ny PHP madio)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Fitadidian'ny Dingana (voafetran'ny S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL Mahazatra (segondra)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Fahalaniana daty mahazatra amin'ny segondra ho an'ny singa ao amin'ny tahiry vonjimaika rehefa tsy misy TTL nomena."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Haben'ny Votoaty Ambony Indrindra (oktety)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Fetra ambony amin'ny oktety ho an'ny votoatin'ny tahiry vonjimaika sy filaharana voasoratra JSON (1024 hatramin'ny 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Tovon'ny Fanalahidy"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Tovon'ny sehatr'anarana fanalahidy ampiharina amin'ny rafitra ambadika iombonana (APCu sy Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL an'ny Hidy Fisorohana Firohotana (segondra)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Faharetan'ny hidy fangatahana tokana amin'ny segondra ho an'ny CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Mpampitombo Beta XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Mpampitombo fahalaniana daty mialoha araka ny vinavina (mahazatra 1.0; ataovy 0 mba hanafoanana ny fikajiana mialoha)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Fahaiza-mitahiry S3-FIFO an'ny Mpamily Fitadidiana"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Isan'ny singa ambony indrindra tazonina ao amin'ny MemoryDriver alohan'ny handehanan'ny fanesorana S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Fampitana Redis (RESP2 amin'ny PHP Madio)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Mpampiantrano Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Anaran'ny mpampiantrano na adiresy IP an'ny mpizara Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Seranana Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Seranana TCP na TLS ho an'ny mpizara Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Alefa ny Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Mifandray amin'ny Redis amin'ny alalan'ny tls:// miaraka amin'ny fanamarinana ny mari-pankatoavan'ny mpiara-mifandray."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Laharan'ny Angon-drakitra Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Laharan'ny angon-drakitra Redis lojika (0 hatramin'ny 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Fe-potoana Farany Redis (segondra)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Fe-potoana farany amin'ny segondra ho an'ny fifandraisana sy famakiana/fanoratana sokety."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Tondro Tsiambaratelo Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Tondro tsiambaratelo voafaritra karazana (env:VAR na vault:plugin:slot); tsy misy teny miafina manta tehirizina mihitsy."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Filaharana Andiany Azo Tohitohizana"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Fitanana Filaharana Mahazatra (segondra)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Faharetan'ny fitanana amin'ny segondra alohan'ny hahafahana maka indray ny singa filaharana tsy nohamarinina."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Isan'ny Andrana Ambony Indrindra Mahazatra"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Isan'ny andrana fandefasana ambony indrindra alohan'ny hamindrana singa ho amin'ny toetra tsy lasa."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Tahirizina ny Tabilao Fanampiny Rehefa Esorina"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Tahirizina ny tabilao plugin_cache_entries, plugin_cache_tags, ary plugin_cache_queue rehefa esorina."


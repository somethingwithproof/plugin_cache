#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zadrži tabele dodatka pri deinstalaciji"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Zadrži tabele plugin_cache_entries, plugin_cache_tags i plugin_cache_queue pri deinstalaciji."


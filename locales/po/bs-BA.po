#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Referenca Redis tajne"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Tipizirana referenca tajne (env:VAR ili vault:plugin:slot); izvorne lozinke se nikada ne pohranjuju."

#: lib/Settings.php
msgid "Resumable Batch Queue"

msgid "Redis Database Index"
msgstr "אינדקס מסד נתונים של Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "מספר מסד נתונים לוגי של Redis (0 עד 15)."


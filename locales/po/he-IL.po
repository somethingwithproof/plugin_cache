msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "משך החכירה בשניות לפני שפריט תור שלא אושר הופך זמין להחזרה."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "מספר ניסיונות מרבי כברירת מחדל"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "מספר ניסיונות המסירה המרבי לפני העברת פריט למצב תור הודעות כושלות."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "שמור טבלאות תוסף בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "שמור את הטבלאות plugin_cache_entries, plugin_cache_tags ו-plugin_cache_queue בעת הסרת ההתקנה."


msgid "Socket connect and read/write timeout in seconds."
msgstr "זמן קצוב לחיבור שקע ולקריאה/כתיבה בשניות."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "הפניית סוד של Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "הפניית סוד מסווגת (env:VAR או vault:plugin:slot); סיסמאות גולמיות אינן נשמרות לעולם."


msgid "Default TTL (seconds)"
msgstr "TTL ברירת מחדל (שניות)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "תפוגת ברירת מחדל לרשומת מטמון בשניות כאשר לא מסופק TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "גודל מטען מרבי (בתים)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "גבול עליון בבתים למטעני מטמון ותור מקודדים ב-JSON (1024 עד 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "קידומת מפתח"


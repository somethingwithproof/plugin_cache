#, php-format
msgid "Dead-letter item #%d was not found."
msgstr "Igikorwa cyananiranye #%d ntikibonetse."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "Shyira akamenyetso mu gasanduku ko kwemeza mbere yo gusiba burundu ibikorwa byananiranye."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."
msgstr "Ibikorwa byananiranye %d byasibwe burundu ku murongo."


#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Itsinda ry'ububiko bw'agateganyo \"%s\" ryahanaguwe (ibibitswe %d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Shyira akamenyetso mu gasanduku ko kwemeza mbere yo guhanagura ibibitswe byose mu bubiko bw'agateganyo."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Ibibitswe byose mu bubiko bw'agateganyo byahanaguwe (ibibitswe %d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Tanga nibura akarango kamwe k'ububiko bw'agateganyo ko gutesha agaciro."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "Uturango %d tw'ububiko bw'agateganyo twateshejwe agaciro."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "Hakuweho ibibitswe %d byarangiye kandi hagarurwa ibihe byo gufata ibikorwa %d byarangiye ku murongo."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Igikorwa cyananiranye #%d cyasubijwe ku murongo."


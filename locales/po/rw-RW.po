#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Porogaramu Iyobora Ububiko bw'Agateganyo"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Porogaramu iyobora y'inyuma ikoreshwa ku bubiko bw'agateganyo bw'ibintu n'ububiko bw'igihe gito."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (isangiwe muri memori)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (umuyoboro wa RESP2 wa PHP yonyine)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Memori y'Igikorwa (ifite igipimo cya S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL Mbanziriza (amasegonda)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Igihe mbanziriza mu masegonda cyo kurangira kw'ikibitswe mu bubiko bw'agateganyo iyo nta TTL yatanzwe."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Ingano Ntarengwa y'Amakuru Yoherezwa (bayite)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Igipimo ntarengwa muri bayite ku makuru abitswe mu bubiko bw'agateganyo n'ay'umurongo yanditse muri JSON (1024 kugeza 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Imbanzirizajambo y'Urufunguzo"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Imbanzirizajambo y'umwanya w'amazina y'imfunguzo ikoreshwa mu bubiko busangiwe (APCu na Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL y'Ifungwa Ririnda Umubyigano (amasegonda)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Igihe mu masegonda cy'ifungwa ry'igikorwa kimwe kuri CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Igipimo cya Beta cya XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Igikubisho cy'amahirwe cyo kurangira mbere y'igihe (mbanziriza ni 1.0; shyiraho 0 kugira ngo uhagarike kubarura bundi bushya mbere y'igihe)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Ubushobozi bwa S3-FIFO bwa Porogaramu Iyobora Memori"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Umubare ntarengwa w'ibibitswe biguma muri MemoryDriver mbere y'uko ikurwamo rya S3-FIFO rikora."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Ubwikorezi bwa Redis (RESP2 ya PHP Yonyine)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Seriveri ya Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Izina rya seriveri cyangwa aderesi IP ya seriveri ya Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Icyambu cya Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Icyambu cya TCP cyangwa TLS cya seriveri ya Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Gukoresha Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Guhuza na Redis ukoresheje tls:// hamwe n'isuzuma ry'icyemezo cy'uruhande rundi."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Inomero y'Ububikoshingiro bwa Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Inomero y'ububikoshingiro bwa Redis (0 kugeza 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Igihe Ntarengwa cyo Gutegereza Redis (amasegonda)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Igihe ntarengwa mu masegonda cyo guhuza umuyoboro no gusoma/kwandika."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Indangabanga ya Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Indangabanga ifite ubwoko (env:VAR cyangwa vault:plugin:slot); amagambo y'ibanga nyakuri ntabwo abikwa na rimwe."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Umurongo w'Ibikorwa by'Icyiciro Ushobora Gukomeza"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Igihe Mbanziriza cyo Gufata Igikorwa ku Murongo (amasegonda)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Igihe mu masegonda mbere y'uko igikorwa cyo ku murongo kitaremezwa gishobora kongera kugarurwa."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Umubare Ntarengwa Mbanziriza w'Igerageza"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Umubare ntarengwa w'inshuro zo kugerageza kohereza mbere yo kwimura igikorwa mu cyiciro cy'ibyananiranye."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Gukomeza Kubika Imbonerahamwe z'Umugereka mu gihe cyo Kuvanaho"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Gukomeza kubika imbonerahamwe za plugin_cache_entries, plugin_cache_tags, na plugin_cache_queue mu gihe cyo kuvanaho."


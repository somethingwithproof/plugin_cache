msgid "Redis Host"
msgstr "Anfitrião Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Nome de anfitrião ou endereço IP do servidor Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Porta Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Porta TCP ou TLS do servidor Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Ativar Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Ligar ao Redis utilizando tls:// com verificação do certificado do par."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Índice da base de dados Redis"


#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Controlador de backend utilizado para cache de objetos e armazenamento temporário."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (memória partilhada)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (socket RESP2 em PHP puro)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Memória de processo (limitada por S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL predefinido (segundos)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Expiração predefinida de entradas da cache em segundos quando não é indicado um TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Tamanho máximo do conteúdo útil (bytes)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Limite máximo em bytes para conteúdos úteis de cache e fila codificados em JSON (1024 a 16777216)."


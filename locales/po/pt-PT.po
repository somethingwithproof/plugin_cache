msgid "Redis Timeout (seconds)"
msgstr "Tempo limite do Redis (segundos)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Tempo limite de ligação e leitura/escrita do socket em segundos."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Referência de segredo Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Referência de segredo tipificada (env:VAR ou vault:plugin:slot); palavras-passe em texto simples nunca são armazenadas."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Fila em lote retomável"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Reserva predefinida da fila (segundos)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Duração da reserva em segundos antes de um item da fila não confirmado poder ser recuperado."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Máximo de tentativas predefinido"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Número máximo de tentativas de entrega antes de mover um item para o estado de não entregue."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Manter tabelas do plugin ao desinstalar"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Preservar as tabelas plugin_cache_entries, plugin_cache_tags e plugin_cache_queue ao desinstalar."


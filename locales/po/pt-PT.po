msgstr "Número máximo de entradas mantidas em MemoryDriver antes de executar a remoção S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Transporte Redis (RESP2 em PHP puro)"


msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Duração em segundos do bloqueio de execução única para CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Fator beta XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Multiplicador probabilístico de expiração antecipada (predefinição 1.0; defina 0 para desativar o recálculo antecipado)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Capacidade S3-FIFO do controlador em memória"


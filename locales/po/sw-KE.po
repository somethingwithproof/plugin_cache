#: cache_admin.php cache_operator.php
msgid "CSRF verification failed. Reload the page and retry."
msgstr "Uthibitishaji wa CSRF umeshindwa. Pakia upya ukurasa na ujaribu tena."

#: cache_admin.php
msgid "Active cache driver connectivity probe succeeded."
msgstr "Jaribio la muunganisho wa kiendeshi cha akiba kinachotumika limefaulu."

#: cache_admin.php
msgid "Active cache driver connectivity probe failed."
msgstr "Jaribio la muunganisho wa kiendeshi cha akiba kinachotumika limeshindwa."

#: cache_admin.php
msgid "Saved plugin_cache configuration."
msgstr "Usanidi wa plugin_cache umehifadhiwa."

#: cache_admin.php
msgid "Unable to save plugin_cache configuration."
msgstr "Imeshindwa kuhifadhi usanidi wa plugin_cache."

#: cache_admin.php
msgid "Unsupported administrator action."
msgstr "Kitendo cha msimamizi hakitumiki."

#: cache_admin.php
msgid "Object Cache Configuration & Driver Health (Administrator)"
msgstr "Usanidi wa Akiba ya Vipengee na Afya ya Kiendeshi (Msimamizi)"

#: cache_operator.php
#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Kundi la akiba \"%s\" limefutwa (maingizo %d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Weka tiki kwenye kisanduku cha uthibitisho kabla ya kufuta maingizo yote ya akiba."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Maingizo yote ya akiba yamefutwa (maingizo %d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Toa angalau lebo moja ya akiba ya kubatilisha."

#: cache_operator.php
#, php-format
msgid "Invalidated %d cache tag(s)."
msgstr "Lebo %d za akiba zimebatilishwa."

#: cache_operator.php
#, php-format
msgid "Pruned %d expired entries and reclaimed %d expired queue leases."
msgstr "Maingizo %d yaliyoisha muda yameondolewa na ukodishaji %d wa foleni ulioisha muda umerejeshwa."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Kipengee kilichoshindwa #%d kimerudishwa kwenye foleni."

#: cache_operator.php
#, php-format
msgid "Dead-letter item #%d was not found."
msgstr "Kipengee kilichoshindwa #%d hakikupatikana."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "Weka tiki kwenye kisanduku cha uthibitisho kabla ya kufuta kabisa vipengee vilivyoshindwa."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."
msgstr "Vipengee %d vya foleni ya vipengee vilivyoshindwa vimefutwa kabisa."

#: cache_operator.php
msgid "Unsupported operator action."
msgstr "Kitendo cha mwendeshaji hakitumiki."

#: cache_operator.php

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Kiendeshi cha Akiba"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Kiendeshi cha nyuma kinachotumika kwa akiba ya vipengee na hifadhi ya muda mfupi."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (kumbukumbu ya pamoja)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (soketi ya RESP2 ya PHP halisi)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Kumbukumbu ya Mchakato (yenye kikomo cha S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL Chaguo-msingi (sekunde)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Muda chaguo-msingi wa kuisha kwa ingizo la akiba kwa sekunde wakati hakuna TTL iliyotolewa."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Ukubwa wa Juu wa Mzigo wa Data (baiti)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Kikomo cha juu kwa baiti kwenye mizigo ya data ya akiba na foleni iliyosimbwa kwa JSON (1024 hadi 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Kiambishi Awali cha Ufunguo"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Kiambishi awali cha nafasi ya majina ya ufunguo kinachotumika katika mifumo ya nyuma ya pamoja (APCu na Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL ya Kifuli cha Msongamano (sekunde)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Muda wa kifuli cha ombi moja kwa sekunde kwa CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Kigezo cha Beta cha XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Kizidishi cha uwezekano wa kuisha muda mapema (chaguo-msingi 1.0; weka 0 kuzima ukokotoaji upya wa mapema)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Uwezo wa S3-FIFO wa Kiendeshi cha Kumbukumbu"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Idadi ya juu ya maingizo yanayohifadhiwa katika MemoryDriver kabla ya uondoaji wa S3-FIFO kuanza."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Usafirishaji wa Redis (RESP2 ya PHP Halisi)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Seva Mwenyeji ya Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Jina la seva mwenyeji au anwani ya IP ya seva ya Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Mlango wa Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Mlango wa TCP au TLS wa seva ya Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Wezesha Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Unganisha na Redis ukitumia tls:// pamoja na uthibitishaji wa cheti cha mshirika."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Kielezo cha Hifadhidata ya Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Nambari ya mantiki ya hifadhidata ya Redis (0 hadi 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Muda wa Mwisho wa Redis (sekunde)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Muda wa mwisho wa kuunganisha soketi na kusoma/kuandika kwa sekunde."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Rejeleo la Siri la Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Rejeleo la siri lenye aina (env:VAR au vault:plugin:slot); manenosiri ghafi hayahifadhiwi kamwe."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Foleni ya Kundi Inayoweza Kuendelezwa"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Ukodishaji Chaguo-msingi wa Foleni (sekunde)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Muda wa ukodishaji kwa sekunde kabla ya kipengee cha foleni ambacho hakijathibitishwa kuweza kurejeshwa."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Majaribio ya Juu Chaguo-msingi"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Idadi ya juu ya majaribio ya uwasilishaji kabla ya kuhamishia kipengee kwenye hali ya vipengee vilivyoshindwa."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Hifadhi Majedwali ya Programu-jalizi Wakati wa Kuondoa"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Hifadhi majedwali ya plugin_cache_entries, plugin_cache_tags, na plugin_cache_queue wakati wa kuondoa programu-jalizi."


#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Upravljački program predmemorije"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Pozadinski upravljački program za predmemoriju objekata i privremenu pohranu."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (dijeljena radna memorija)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (čista PHP RESP2 priključnica)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Memorija procesa (ograničena pomoću S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Zadani TTL (sekunde)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Zadano vrijeme isteka unosa predmemorije u sekundama kada TTL nije naveden."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Maksimalna veličina korisnog tereta (bajtovi)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Gornja granica u bajtovima za JSON kodirani sadržaj predmemorije i redova čekanja (od 1024 do 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Prefiks ključa"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Prefiks imenskog prostora ključeva koji se primjenjuje u dijeljenim pozadinskim sustavima (APCu i Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL zaključavanja protiv navale zahtjeva (sekunde)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Trajanje pojedinačnog zaključavanja u sekundama za CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Beta faktor za XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Vjerojatnosni množitelj ranog isteka (zadano 1.0; postavite na 0 za onemogućivanje ranog ponovnog izračuna)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "S3-FIFO kapacitet memorijskog upravljačkog programa"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Najveći broj unosa zadržanih u upravljačkom programu MemoryDriver prije pokretanja S3-FIFO izbacivanja."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis prijenos (čisti PHP RESP2)"


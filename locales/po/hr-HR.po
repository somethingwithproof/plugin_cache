msgid "Redis Host"
msgstr "Redis poslužitelj"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Naziv računala ili IP adresa Redis poslužitelja."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Redis priključak"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "TCP ili TLS priključak za Redis poslužitelj."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Omogući Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Poveži se na Redis putem tls:// uz provjeru certifikata druge strane."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Indeks Redis baze podataka"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Logički broj Redis baze podataka (od 0 do 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Vremensko ograničenje za Redis (sekunde)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Vremensko ograničenje povezivanja i čitanja/pisanja priključnice u sekundama."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Referenca tajne za Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Tipizirana referenca tajne (env:VAR ili vault:plugin:slot); izvorne lozinke nikada se ne pohranjuju."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Nastavljivi skupni red čekanja"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Zadani zakup reda čekanja (sekunde)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Trajanje zakupa u sekundama prije nego što nepotvrđena stavka reda postane ponovno dostupna za preuzimanje."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Zadani najveći broj pokušaja"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Najveći broj pokušaja isporuke prije prebacivanja stavke u status neisporučene stavke."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Zadrži tablice dodatka pri deinstalaciji"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Sačuvaj tablice plugin_cache_entries, plugin_cache_tags i plugin_cache_queue pri deinstalaciji."


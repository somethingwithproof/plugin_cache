#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Драйвер кэша"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Серверный драйвер, используемый для кэша объектов и временного хранилища."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (общая память)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (сокет RESP2 на чистом PHP)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Память процесса (ограничено S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL по умолчанию (секунды)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Срок действия записи кэша по умолчанию в секундах, если TTL не указан."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Максимальный размер полезной нагрузки (байты)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Верхний предел в байтах для полезной нагрузки кэша и очереди в формате JSON (от 1024 до 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Префикс ключей"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Префикс пространства имен ключей, применяемый в общих хранилищах (APCu и Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL блокировки от лавинообразных запросов (секунды)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Длительность однопоточной блокировки в секундах для CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Бета-коэффициент XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Множитель вероятностного досрочного истечения срока действия (по умолчанию 1.0; укажите 0 для отключения досрочного пересчета)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Емкость S3-FIFO драйвера памяти"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Максимальное число записей, хранимых в MemoryDriver до запуска вытеснения S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Транспорт Redis (RESP2 на чистом PHP)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Хост Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Имя хоста или IP-адрес сервера Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Порт Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Порт TCP или TLS для сервера Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Включить Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Подключаться к Redis через tls:// с проверкой сертификата узла."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Индекс базы данных Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Логический номер базы данных Redis (от 0 до 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Тайм-аут Redis (секунды)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Тайм-аут подключения и чтения/записи сокета в секундах."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Ссылка на секрет Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Типизированная ссылка на секрет (env:VAR или vault:plugin:slot); пароли в открытом виде никогда не сохраняются."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Возобновляемая пакетная очередь"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Аренда элемента очереди по умолчанию (секунды)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Длительность аренды в секундах, по истечении которой неподтвержденный элемент очереди может быть возвращен в обработку."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Максимум попыток по умолчанию"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Максимальное число попыток доставки перед переводом элемента в очередь недоставленных сообщений."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Сохранять таблицы плагина при удалении"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Сохранять таблицы plugin_cache_entries, plugin_cache_tags и plugin_cache_queue при удалении плагина."


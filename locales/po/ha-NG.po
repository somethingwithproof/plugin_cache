#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Direban Ajiyar Wucin Gadi"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Direban baya da ake amfani da shi don ajiyar abubuwa ta wucin gadi da ajiyar ɗan lokaci."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (ajiyar ƙwaƙwalwa ta tarayya)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (soket ɗin RESP2 na PHP zalla)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Ƙwaƙwalwar Tsari (mai iyaka ta S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Tsohon TTL (daƙiƙa)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Tsohon lokacin ƙarewar shigarwar ajiyar wucin gadi a cikin daƙiƙa idan ba a bayar da TTL ba."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Matsakaicin Girman Bayanai (baitoci)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Mafi girman adadin baitoci ga bayanan ajiyar wucin gadi da layi da aka tsara da JSON (1024 zuwa 16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Gaban Mabuɗi"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Gaban sunan sararin mabuɗi da ake amfani da shi a tsarin baya na tarayya (APCu da Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "TTL na Kullen Kare Cunkoso (daƙiƙa)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Tsawon lokacin kullen aiki guda ɗaya a cikin daƙiƙa don CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Ma'aunin Beta na XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Mai ninka yuwuwar ƙarewar lokaci da wuri (tsoho 1.0; saita 0 don kashe sake lissafi da wuri)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Ƙarfin S3-FIFO na Direban Ƙwaƙwalwa"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Matsakaicin adadin shigarwar da ake ajiyewa a cikin MemoryDriver kafin fitarwa ta S3-FIFO ta fara aiki."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Hanyar Sadarwar Redis (RESP2 na PHP Zalla)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Sabar Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Sunan sabar ko adireshin IP na sabar Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Tashar Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Tashar TCP ko TLS don sabar Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Kunna Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Haɗa zuwa Redis ta amfani da tls:// tare da tantance takardar shaidar abokin haɗi."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Lambar Rumbun Bayanan Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Lambar rumbun bayanan Redis ta ma'ana (0 zuwa 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Ƙarewar Lokacin Redis (daƙiƙa)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Lokacin ƙarewar haɗin soket da karatu/rubutu a cikin daƙiƙa."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Nassin Sirrin Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Nassin sirri mai nau'i (env:VAR ko vault:plugin:slot); ba a taɓa ajiye kalmomin sirri a bayyane ba."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Layin Ayyuka na Rukuni Mai Ci Gaba"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Tsohon Lokacin Riƙewar Layi (daƙiƙa)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Tsawon lokacin riƙewa a cikin daƙiƙa kafin abun layin da ba a tabbatar da shi ba ya zama mai iya dawowa."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Tsohon Matsakaicin Gwaji"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Matsakaicin yawan gwajin isarwa kafin a matsar da abu zuwa matsayin saƙon da ya gaza."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Ajiye Teburan Ƙarin Manhaja Lokacin Cire Manhaja"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Kiyaye teburan plugin_cache_entries, plugin_cache_tags, da plugin_cache_queue lokacin cire manhaja."


#, php-format
msgid "Flushed cache group \"%s\" (%d entries)."
msgstr "Iqela lekheshe \"%s\" licociwe (amangeno ayi-%d)."

#: cache_operator.php
msgid "Tick the confirmation box before flushing all cache entries."
msgstr "Phawula ibhokisi yoqinisekiso phambi kokucoca onke amangeno ekheshe."

#: cache_operator.php
#, php-format
msgid "Flushed all cache entries (%d entries)."
msgstr "Onke amangeno ekheshe acociwe (amangeno ayi-%d)."

#: cache_operator.php
msgid "Provide at least one cache tag to invalidate."
msgstr "Nika ubuncinane ithegi enye yekheshe efuna ukubhangiswa."

#: cache_operator.php
#, php-format

msgstr "Kususwe amangeno aphelelwe lixesha ayi-%d kwaye kwabuyiswa iingqeshiso zolayini eziphelelwe lixesha eziyi-%d."

#: cache_operator.php
#, php-format
msgid "Requeued dead-letter item #%d."
msgstr "Into yolayini wemiyalezo esileleyo #%d ibuyiselwe kulayini."

#: cache_operator.php
#, php-format
msgid "Dead-letter item #%d was not found."
msgstr "Into yolayini wemiyalezo esileleyo #%d ayifumanekanga."

#: cache_operator.php
msgid "Tick the confirmation box before purging dead-letter items."
msgstr "Phawula ibhokisi yoqinisekiso phambi kokucima izinto zolayini wemiyalezo esileleyo."

#: cache_operator.php
#, php-format
msgid "Purged %d dead-letter queue item(s)."

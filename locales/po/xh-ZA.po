#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Umqhubi weKheshe"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Umqhubi wangemva osetyenziselwa ikheshe yezinto nogcino lwexeshana."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (ekwabelwana ngayo kwimemori)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (isokhethi ye-RESP2 ye-PHP emsulwa)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Imemori yeNkqubo (elinganiselweyo nge-S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "I-TTL Emiselweyo (imizuzwana)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Ixesha elimiselweyo lokuphelelwa kwengeno lekheshe ngemizuzwana xa kungekho TTL inikiweyo."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Elona Nani Liphezulu loBungakanani boMthwalo (iibhayithi)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Umda ophezulu ngeebhayithi kwimithwalo yekheshe nolayini efakwe ikhowudi ye-JSON (1024 ukuya ku-16777216)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Isimaphambili seSitshixo"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Isimaphambili sendawo yegama yesitshixo esisetyenziswa kwiinkqubo zangemva ekwabelwana ngazo (APCu kunye ne-Redis)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "I-TTL yeTshixo loXinano (imizuzwana)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Ubude bexesha letshixo lomsebenzi omnye ngemizuzwana kwi-CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Ifektha ye-Beta ye-XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Isiphindaphindi sethuba lokuphelelwa kwangaphambili (okumiselweyo ngu-1.0; misela u-0 ukucima ukubala kwakhona kwangaphambili)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Umthamo we-S3-FIFO woMqhubi weMemori"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Elona nani liphezulu lamangeno agcinwa kwi-MemoryDriver phambi kokuba kusebenze ukukhutshwa kwe-S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Uthutho lwe-Redis (I-RESP2 ye-PHP emsulwa)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Umamkeli we-Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Igama lomamkeli okanye idilesi ye-IP yeseva ye-Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Iphothi ye-Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Iphothi ye-TCP okanye ye-TLS yeseva ye-Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Vula i-Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Qhagamshela kwi-Redis usebenzisa i-tls:// kunye noqinisekiso lwesatifikethi somlingane."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Isalathisi soGcino-lwazi lwe-Redis"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Inani logcino-lwazi olusengqiqweni lwe-Redis (0 ukuya ku-15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Ixesha Lokuphela kwe-Redis (imizuzwana)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Ixesha lokuphela loqhagamshelo lwesokhethi nokufunda/ukubhala ngemizuzwana."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Isalathiso seMfihlo ye-Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Isalathiso semfihlo esichaziweyo (env:VAR okanye vault:plugin:slot); amagama okugqitha ngqo akaze agcinwe."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Ulayini weQela Oqhubekekayo"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Ingqeshiso yoLayini Emiselweyo (imizuzwana)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Ubude bexesha lengqeshiso ngemizuzwana phambi kokuba into yolayini engaqinisekiswanga ibe nokubuyiswa."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Elona Nani Liphezulu leMizamo Emiselweyo"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Elona nani liphezulu lemizamo yokuthumela phambi kokuhambisa into kwimo yemiyalezo esileleyo."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Gcina iiTheyibhile zeSongezelelo xa Kukhutshwa"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Gcina iitheyibhile ze-plugin_cache_entries, plugin_cache_tags, kunye ne-plugin_cache_queue xa kukhutshwa isongezelelo."


msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "Durata in secondi del blocco a esecuzione singola per CacheService::remember()."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "Fattore beta XFetch"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Moltiplicatore probabilistico di scadenza anticipata (predefinito 1.0; imposta 0 per disabilitare il ricalcolo anticipato)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Capacità S3-FIFO del driver in memoria"


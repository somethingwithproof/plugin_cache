msgid "Logical Redis database number (0 through 15)."
msgstr "Numero del database logico Redis (da 0 a 15)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Timeout Redis (secondi)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Timeout di connessione e lettura/scrittura del socket in secondi."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Riferimento segreto Redis"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Riferimento segreto tipizzato (env:VAR o vault:plugin:slot); le password in chiaro non vengono mai memorizzate."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Coda batch ripristinabile"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Assegnazione coda predefinita (secondi)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Durata dell'assegnazione in secondi prima che un elemento della coda non confermato possa essere recuperato."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Numero massimo tentativi predefinito"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Numero massimo di tentativi di consegna prima di spostare un elemento nello stato non recapitabile."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Mantieni le tabelle del plugin alla disinstallazione"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Conserva le tabelle plugin_cache_entries, plugin_cache_tags e plugin_cache_queue alla disinstallazione."


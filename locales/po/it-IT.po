msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "Numero massimo di voci mantenute in MemoryDriver prima che venga eseguita la rimozione S3-FIFO."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Trasporto Redis (RESP2 in puro PHP)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Host Redis"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Nome host o indirizzo IP del server Redis."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Porta Redis"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Porta TCP o TLS del server Redis."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Abilita Redis TLS"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Connetti a Redis utilizzando tls:// con verifica del certificato del peer."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Indice database Redis"


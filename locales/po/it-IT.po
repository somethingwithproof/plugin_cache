#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Driver di backend utilizzato per la cache degli oggetti e l'archiviazione temporanea."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (condivisa in memoria)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (socket RESP2 in puro PHP)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "Memoria di processo (limitata S3-FIFO)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "TTL predefinito (secondi)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "Scadenza predefinita in secondi delle voci di cache quando non viene fornito alcun TTL."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "Dimensione massima del payload (byte)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "Limite massimo in byte per i payload di cache e coda codificati in JSON (da 1024 a 16777216)."


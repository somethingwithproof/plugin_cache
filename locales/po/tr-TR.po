#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Cache Driver"
msgstr "Önbellek Sürücüsü"

#: lib/Settings.php
msgid "Backend driver used for object cache and transient storage."
msgstr "Nesne önbelleği ve geçici depolama için kullanılan arka uç sürücüsü."

#: lib/Settings.php
msgid "MariaDB (plugin_cache_entries)"
msgstr "MariaDB (plugin_cache_entries)"

#: lib/Settings.php
msgid "APCu (in-memory shared)"
msgstr "APCu (bellek içi paylaşımlı)"

#: lib/Settings.php
msgid "Redis (pure-PHP RESP2 socket)"
msgstr "Redis (saf PHP RESP2 soketi)"

#: lib/Settings.php
msgid "Process Memory (S3-FIFO bounded)"
msgstr "İşlem Belleği (S3-FIFO sınırlı)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Default TTL (seconds)"
msgstr "Varsayılan TTL (saniye)"

#: lib/Settings.php
msgid "Default cache entry expiration in seconds when no TTL is supplied."
msgstr "TTL belirtilmediğinde saniye cinsinden varsayılan önbellek girdisi geçerlilik süresi."

#: lib/Settings.php
msgid "Maximum Payload Size (bytes)"
msgstr "En Fazla Yük Boyutu (bayt)"

#: lib/Settings.php
msgid "Upper bound in bytes on JSON-encoded cache and queue payloads (1024 to 16777216)."
msgstr "JSON kodlu önbellek ve kuyruk yükleri için bayt cinsinden üst sınır (1024 ile 16777216 arası)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Key Prefix"
msgstr "Anahtar Ön Eki"

#: lib/Settings.php
msgid "Key namespace prefix applied in shared backends (APCu and Redis)."
msgstr "Paylaşımlı arka uçlarda (APCu ve Redis) uygulanan anahtar ad alanı ön eki."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Stampede Lock TTL (seconds)"
msgstr "Yığılma Kilidi TTL (saniye)"

#: lib/Settings.php
msgid "Single-flight lock duration in seconds for CacheService::remember()."
msgstr "CacheService::remember() için saniye cinsinden tekil yürütme kilidi süresi."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "XFetch Beta Factor"
msgstr "XFetch Beta Katsayısı"

#: lib/Settings.php
msgid "Probabilistic early-expiration multiplier (default 1.0; set 0 to disable early recompute)."
msgstr "Olasılıksal erken süre sonu çarpanı (varsayılan 1.0; erken yeniden hesaplamayı devre dışı bırakmak için 0 girin)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Memory Driver S3-FIFO Capacity"
msgstr "Bellek Sürücüsü S3-FIFO Kapasitesi"

#: lib/Settings.php
msgid "Maximum entries retained in MemoryDriver before S3-FIFO eviction runs."
msgstr "S3-FIFO tahliyesi çalışmadan önce MemoryDriver içinde tutulan en fazla girdi sayısı."

#: lib/Settings.php
msgid "Redis Transport (Pure-PHP RESP2)"
msgstr "Redis Aktarımı (Saf PHP RESP2)"

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Host"
msgstr "Redis Ana Bilgisayarı"

#: lib/Settings.php
msgid "Hostname or IP address for the Redis server."
msgstr "Redis sunucusu için ana bilgisayar adı veya IP adresi."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Port"
msgstr "Redis Bağlantı Noktası"

#: lib/Settings.php
msgid "TCP or TLS port for the Redis server."
msgstr "Redis sunucusu için TCP veya TLS bağlantı noktası."

#: lib/Settings.php
msgid "Enable Redis TLS"
msgstr "Redis TLS'yi Etkinleştir"

#: lib/Settings.php
msgid "Connect to Redis using tls:// with peer certificate verification."
msgstr "Eş sertifika doğrulaması ile tls:// kullanarak Redis'e bağlan."

#: lib/Settings.php
msgid "Redis Database Index"
msgstr "Redis Veritabanı Dizini"

#: lib/Settings.php
msgid "Logical Redis database number (0 through 15)."
msgstr "Mantıksal Redis veritabanı numarası (0 ile 15 arası)."

#: lib/Settings.php lib/Ui/PagesRenderer.php
msgid "Redis Timeout (seconds)"
msgstr "Redis Zaman Aşımı (saniye)"

#: lib/Settings.php
msgid "Socket connect and read/write timeout in seconds."
msgstr "Saniye cinsinden soket bağlantısı ve okuma/yazma zaman aşımı."

#: lib/Settings.php
msgid "Redis Secret Reference"
msgstr "Redis Gizli Bilgi Başvurusu"

#: lib/Settings.php
msgid "Typed secret reference (env:VAR or vault:plugin:slot); raw passwords are never stored."
msgstr "Türlü gizli bilgi başvurusu (env:VAR veya vault:plugin:slot); ham parolalar asla saklanmaz."

#: lib/Settings.php
msgid "Resumable Batch Queue"
msgstr "Sürdürülebilir Toplu Kuyruk"

#: lib/Settings.php
msgid "Default Queue Lease (seconds)"
msgstr "Varsayılan Kuyruk Kiralaması (saniye)"

#: lib/Settings.php
msgid "Lease duration in seconds before an unacknowledged queue item becomes reclaimable."
msgstr "Onaylanmamış bir kuyruk öğesinin geri alınabilir hale gelmesinden önce saniye cinsinden kiralama süresi."

#: lib/Settings.php
msgid "Default Max Attempts"
msgstr "Varsayılan En Fazla Deneme"

#: lib/Settings.php
msgid "Maximum delivery attempts before moving an item to dead-letter status."
msgstr "Bir öğe ölü ileti durumuna taşınmadan önceki en fazla teslimat denemesi sayısı."

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "Kaldırırken Eklenti Tablolarını Koru"

#: lib/Settings.php
msgid "Preserve plugin_cache_entries, plugin_cache_tags, and plugin_cache_queue tables on uninstall."
msgstr "Kaldırma sırasında plugin_cache_entries, plugin_cache_tags ve plugin_cache_queue tablolarını koru."

